# ==============================================================================
# Classsbuk Transcript Reviewer — Drive Edition
# ==============================================================================

# --- Polling ---
# How often to check for new files (milliseconds).
POLL_INTERVAL_MS=30000

# --- LLM Evaluation ---
# "mock" = returns fake scores
# "local" = runs local Ollama (requires Ollama running locally)
# "anthropic" = cloud API via Claude (requires ANTHROPIC_API_KEY)
# "openai" = cloud API via GPT-4o (requires OPENAI_API_KEY)
# "gemini" = cloud API via Gemini-1.5-flash (requires GEMINI_API_KEY)
# NOTE: The system auto-detects keys and selects providers in this order: anthropic > openai > gemini.
EVALUATION_PROVIDER=local

# --- Provider Keys & Models ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Local Ollama Config ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# --- Google Integration ---
# Path to Google Service Account JSON file (relative or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
# URL of the Google Drive folder containing transcripts
GOOGLE_DRIVE_FOLDER_URL=
# URL of the Google Sheet to append evaluation results
GOOGLE_SHEET_URL=
