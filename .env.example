# ==============================================================================
# Classsbuk Video — AI Class Recording Review (MVP - Local AI Edition)
# ==============================================================================

# --- Polling ---
# How often to check for new files (milliseconds).
POLL_INTERVAL_MS=30000

# --- Transcription ---
# "mock" = returns fake transcript
# "assemblyai" = cloud API (requires API key)
# "local" = runs faster-whisper locally (uses Python env, requires scripts/setup-local-ai.ps1)
# NOTE: If ASSEMBLYAI_API_KEY is provided, "assemblyai" is used automatically instead of "local".
TRANSCRIPTION_PROVIDER=local
ASSEMBLYAI_API_KEY=
# Local Whisper model: tiny (fastest, ~70MB), base (good balance, ~140MB), small (slow, ~460MB)
WHISPER_MODEL_SIZE=base

# --- LLM Evaluation ---
# "mock" = returns fake scores
# "anthropic" = cloud API via Claude (requires API key)
# "local" = runs local Ollama (requires Ollama running locally)
# NOTE: If ANTHROPIC_API_KEY is provided, "anthropic" is used automatically instead of "local".
EVALUATION_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Local Ollama Config ---
OLLAMA_URL=http://127.0.0.1:11434
# Better 8B model suitable for RTX 4060 (8GB VRAM)
OLLAMA_MODEL=llama3.1
# Multimodal vision model for visual frame analysis
OLLAMA_VISION_MODEL=llava

# --- Google Integration ---
# Path to Google Service Account JSON file (relative or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
# URL of the Google Drive folder containing videos
GOOGLE_DRIVE_FOLDER_URL=
# URL of the Google Sheet to append evaluation results
GOOGLE_SHEET_URL=

# --- Visual Event Detection ---
# Fallback fixed interval if visual detection fails (default: 60)
FRAME_EXTRACT_INTERVAL_SEC=60
# Base thumbnail sampling interval in seconds (default: 3)
VISUAL_THUMB_INTERVAL_SEC=3
# Pixel diff threshold (0-100) to trigger a visual event (default: 5)
VISUAL_CHANGE_THRESHOLD=5
# Max frames to send to vision LLM per video (default: 30)
VISUAL_MAX_EVENTS=30
# Enable OCR validation for borderline frames (default: true)
VISUAL_OCR_ENABLED=true
# Scanning mode: check every Nth thumbnail (default: 5, i.e. every 15s)
VISUAL_SCAN_STEP=5
# Tracking mode: return to scanning after N stable thumbnails (default: 10, i.e. 30s)
VISUAL_TRACK_STABILITY=10

